# SUPABASE — Project Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Solo lato server (script account + funzione promemoria). MAI con prefisso VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-secret-key"

# RESEND — invio email promemoria 24h prima
RESEND_API_KEY="re_123456789"
RESEND_FROM="Il Sogno della Bellezza <prenotazioni@ilsognodellabellezza.it>"

# VERCEL CRON — protegge /api/cron/reminder-emails
CRON_SECRET="your-secure-cron-secret"
